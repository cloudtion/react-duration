{
  "name": "react-duration",
  "version": "1.1.0",
  "description": "Duration input field for react.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudtion/react-duration.git"
  },
  "keywords": [
    "react",
    "time",
    "duration",
    "input"
  ],
  "author": "William Jacobs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cloudtion/react-duration/issues"
  },
  "homepage": "https://github.com/cloudtion/react-duration#readme",
  "dependencies": {
    "duration-str": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.17.0"
  }
